# Tempo API Token (Used to log your time)
# Generate at: Jira -> Apps -> Tempo -> Settings -> API Integration
TEMPO_TOKEN="your_tempo_api_token_here"

# Jira Domain
# Example: company.atlassian.net
JIRA_DOMAIN="your_company_domain_here"

# Jira Email
# The exact email address you use to log into Jira
JIRA_EMAIL="your_email@example.com"

# Jira API Token (Used to read your tickets and project data)
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="your_jira_api_token_here"

# Atlassian Account ID
# The 24-character alphanumeric string identifying your user
# (If you don't know this, run python setup.py to fetch it automatically)
AUTHOR_ACCOUNT_ID="your_atlassian_account_id_here"
